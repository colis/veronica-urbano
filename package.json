{
	"name": "veronica-urbano",
	"version": "1.0.0",
	"description": "WordPress project for the veronicaurbano.it website.",
	"author": {
		"name": "Carmine Colicino",
		"email": "carminecolicino@gmail.com",
		"url": "https://github.com/colis",
		"role": "developer"
	},
	"license": "MIT",
	"scripts": {
		"start": "composer install --ignore-platform-reqs && npm install && npm run build",
		"build": "wp-scripts build",
		"watch": "wp-scripts start",
		"build-release": "npm install && composer install --no-dev -o && npm run build",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"lint:php": "composer run lint:phpcs",
		"lint-fix:php": "composer run lint:phpcbf",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.scss": [
			"npm run lint:css"
		],
		"*.js": [
			"npm run lint:js"
		],
		"*.php": [
			"npm run lint:php"
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/colis/veronica-urbano"
	},
	"devDependencies": {
		"@10up/block-components": "^1.23.0",
		"@csstools/postcss-global-data": "^4.0.0",
		"@lehoczky/postcss-fluid": "^1.0.3",
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/blocks": "^17.1.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/data": "^11.1.0",
		"@wordpress/dom-ready": "^5.1.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/html-entities": "^5.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/icons": "^20.0.0",
		"@wordpress/rich-text": "^8.1.0",
		"@wordpress/scripts": "^37.1",
		"autoprefixer": "^10.6.2",
		"cssnano": "^9.9.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"postcss": "^8.5.33",
		"postcss-assets": "^6.0.0",
		"postcss-functions": "^4.0.2",
		"postcss-mixins": "^12.1.2",
		"postcss-nested": "^9.0.1",
		"postcss-preset-env": "^11.6.2",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-organize-imports": "^4.3.0"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
