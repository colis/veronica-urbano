<?xml version="1.0"?>
<ruleset name="VU Coding Standards">
	<arg value="sp" /><!-- Show sniff codes in all reports. -->
	<arg name="colors" /> <!-- Show results with colors. Disable if working on Windows -->
	<arg name="extensions" value="php" /> <!-- Limit to PHP files -->
	<arg name="report-width" value="80" /> <!-- How many columns wide screen reports should be -->
	<arg name="severity" value="1" />

	<!-- Rules: Check PHP version compatibility - see https://github.com/PHPCompatibility/PHPCompatibilityWP -->
	<rule ref="PHPCompatibilityWP"/>
	<!-- For help in understanding this testVersion: https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<config name="testVersion" value="8.4-"/>

	<rule ref="WordPress">
		<exclude name="Universal.Arrays.DisallowShortArraySyntax" />
		<exclude name="Universal.Operators.DisallowShortTernary" />
		<exclude name="WordPress.PHP.YodaConditions.NotYoda" />

		<!-- Sometimes we use the PSR4 autoloading standard which conflicts with these rules. -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
	</rule>

	<!-- Allow . in hook names. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="." />
		</properties>
	</rule>

	<!-- Disallow long array syntax. -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax" />

	<!-- Namespacing required for classes. -->
	<rule ref="PSR1.Classes.ClassDeclaration" />

	<!-- Allow @inheritDoc -->
	<rule ref="Squiz.Commenting.FunctionComment">
		<properties>
			<property name="skipIfInheritdoc" value="true" />
		</properties>
	</rule>

	<!-- Build tool config/scripts. -->
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/.cursor/*</exclude-pattern>
	<exclude-pattern>dist/*</exclude-pattern>

	<!-- Third-party plugins and themes. -->
	<exclude-pattern>^(?!.*/plugins/vu-*|.*/themes/vu*).*</exclude-pattern>

	<!-- Other files and folders -->
</ruleset>
