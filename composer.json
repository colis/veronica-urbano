{
	"name": "colis/veronica-urbano",
	"description": "WordPress project for the veronicaurbano.it website",
	"type": "project",
	"license": "MIT",
	"homepage": "https://www.veronicaurbano.it/",
	"authors": [
		{
			"name": "Carmine Colicino",
			"email": "carminecolicino@gmail.com"
		}
	],
	"config": {
		"autoloader-suffix": "VU",
		"preferred-install": "dist",
		"process-timeout": 600,
		"sort-packages": true,
		"vendor-dir": "mu-plugins/vendor",
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"require": {
		"php": ">=8.4.27",
		"johnbillion/extended-cpts": "^5.1",
		"league/container": "^5.0",
		"wpackagist-plugin/imagify": "^2.0",
		"wpackagist-plugin/safe-svg": "^2.5",
		"wpackagist-plugin/wordfence": "^9.0",
		"wpackagist-plugin/wordpress-seo": "^28.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1.3",
		"roave/security-advisories": "dev-latest",
		"squizlabs/php_codesniffer": "^3.13.6",
		"wp-coding-standards/wpcs": "dev-develop",
		"wpackagist-plugin/query-monitor": "^4.1",
		"wpackagist-plugin/regenerate-thumbnails": "^3.1.3"
	},
	"scripts": {
		"lint:phpcs": [
			"phpcs"
		],
		"lint:phpcbf": [
			"phpcbf ."
		]
	},
	"extra": {
		"installer-paths": {
			"plugins/{$name}": [
				"type:wordpress-plugin"
			],
			"themes/{$name}": [
				"type:wordpress-theme"
			]
		}
	},
	"autoload": {
		"files": [
			"plugins/vu-core/includes/functions/global.php"
		],
		"psr-4": {
			"VUBlocks\\": "plugins/vu-blocks/includes/classes",
			"VUCore\\": "plugins/vu-core/includes/classes",
			"VUTheme\\": "themes/vu/includes/classes"
		}
	}
}
